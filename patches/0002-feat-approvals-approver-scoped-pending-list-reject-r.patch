+	if actor.Admin {
+		return nil
+	}
+	for _, want := range approvers {
+		if strings.EqualFold(strings.TrimSpace(want), actor.Login) {
+			return nil
+		}
+	}
+	return fmt.Errorf("当前账号 %s 不在该节点的审批人名单（%s）", actor.Login, who)
