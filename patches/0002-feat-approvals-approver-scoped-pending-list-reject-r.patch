+	for _, n := range r.WorkflowSnapshot.Nodes {
+		if n.ID == nodeID {
+			approvers = n.Approvers
+			label = n.ApproverLabel
+			break
+		}
+	}
+	if len(approvers) == 0 {
+		return nil
+	}
+	who := label
+	if who == "" {
+		who = strings.Join(approvers, "、")
+	}
+	if actor.Login == "" {
+		return fmt.Errorf("该节点需指定审批人（%s），请以被指定账号登录或使用其访问密钥操作", who)
